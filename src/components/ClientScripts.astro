---
// Client-side scripts for image optimization and interactions
---

<!-- Google Analytics -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }

  // Lazy load Google Analytics
  const loadGA = () => {
    const script = document.createElement('script');
    script.src = 'https://www.googletagmanager.com/gtag/js?id=G-DT01FBW30E';
    script.async = true;
    document.head.appendChild(script);

    gtag('js', new Date());
    gtag('config', 'G-DT01FBW30E');
  };

  // Wait for user interaction or delay
  const triggerGA = () => {
    window.removeEventListener('scroll', triggerGA);
    window.removeEventListener('mousemove', triggerGA);
    window.removeEventListener('touchstart', triggerGA);
    loadGA();
  };

  const armGA = () => {
    window.addEventListener('scroll', triggerGA, { once: true });
    window.addEventListener('mousemove', triggerGA, { once: true });
    window.addEventListener('touchstart', triggerGA, { once: true });
    setTimeout(() => {
      // Fallback if no interaction after 5s
      if (!window.dataLayer.length) loadGA();
    }, 5000);
  };

  // A hover-prerendered page the reader never opens must not count as a visit.
  if (document.prerendering) {
    document.addEventListener('prerenderingchange', armGA, { once: true });
  } else {
    armGA();
  }
</script>

<!-- GEOInflow; async so a slow fetch never holds DOMContentLoaded, and the script itself waits out a hover prerender -->
<script is:inline async src='https://geo.tw93.fun/geo.js' data-website-id='6e0320f4-f274-41d1-b2b3-4ae01e92f73b' data-domains='weekly.tw93.fun'></script>

<script is:inline>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').then(
        (registration) => {
          console.log('SW registered: ', registration);
        },
        (registrationError) => {
          console.log('SW registration failed: ', registrationError);
        }
      );
    });
  }
</script>

<script>
  // Styles stay static: with inlined stylesheets a dynamically imported CSS
  // file is never emitted and its 404 would reject the whole lightbox import.
  import 'photoswipe/style.css';

  // The PhotoSwipe script loads only on pages with body images, so the home
  // feed does not download it.
  const initLightbox = async () => {
    const { default: PhotoSwipeLightbox } = await import('photoswipe/lightbox');

    // Initialize PhotoSwipe
    const lightbox = new PhotoSwipeLightbox({
      gallery: '#write',
      children: 'img:not(.pswp-ignore)',
      pswpModule: () => import('photoswipe'),
      imageClickAction: 'zoom',
      tapAction: 'close',
      doubleTapAction: 'zoom',
      bgClickAction: 'close',
      bgOpacity: 0.8,
      padding: { top: 20, bottom: 20, left: 20, right: 20 },
      showHideAnimationType: 'zoom',
      showAnimationDuration: 300,
      hideAnimationDuration: 300,
    });

    // PhotoSwipe scales the zoom wrap with a transform, so a fixed radius on the
    // image would scale with it. The wrap carries --pswp-img-radius = radius / scale.
    // It is set in the same task PhotoSwipe writes a transform, and while a CSS
    // transition animates that transform, one script animation replays the same
    // transform together with the radius, so the corners stay at --radius on screen
    // every frame. Animating the radius alone left the transform on the compositor:
    // whenever the main thread stalled, the image kept growing while the radius
    // waited, and the corners grew with it until the last frame.
    const radius = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--radius')) || 8;
    const scaleOf = (transform: string) => (transform && transform !== 'none' ? new DOMMatrixReadOnly(transform).a : 1) || 1;
    const setRadius = (wrap: HTMLElement, scale: number) => wrap.style.setProperty('--pswp-img-radius', `${radius / scale}px`);
    const syncWrap = (wrap?: HTMLElement) => {
      if (!wrap || wrap.getAnimations().some((a) => a.id === 'pswp-radius')) return;
      setRadius(wrap, scaleOf(getComputedStyle(wrap).transform));
    };
    const syncSlides = () => {
      lightbox.pswp?.mainScroll.itemHolders.forEach(({ slide }) => {
        const wrap = slide?.container;
        if (!wrap) return;
        syncWrap(wrap);
        const background = slide.data.svgBackground;
        if (background && wrap.dataset.svgBackground !== background) {
          wrap.dataset.svgBackground = background;
          wrap.style.setProperty('--pswp-img-bg', background);
        }
      });
    };

    const onTransitionRun = (event: TransitionEvent) => {
      const wrap = event.target as HTMLElement;
      if (event.propertyName !== 'transform' || !wrap.classList?.contains('pswp__zoom-wrap')) return;
      const transition = wrap.getAnimations().find((a) => (a as CSSTransition).transitionProperty === 'transform');
      const effect = transition?.effect as KeyframeEffect | null;
      if (!transition || !effect) return;
      const keyframes = effect.getKeyframes();
      const [from, to] = keyframes.map((frame) => scaleOf(String(frame.transform)));
      const { duration, easing } = effect.getTiming();
      wrap.getAnimations().forEach((a) => a.id === 'pswp-radius' && a.cancel());
      // Keyframe offsets live in eased progress, where the transition moves the
      // scale linearly, so sampling radius / scale there tracks it frame for frame.
      // The custom property keeps this effect off the compositor, and as a script
      // animation it overrides the transition's transform with identical values.
      const steps = 24;
      const frames: Keyframe[] = Array.from({ length: steps + 1 }, (_, i) => ({
        offset: i / steps,
        '--pswp-img-radius': `${radius / (from + ((to - from) * i) / steps)}px`,
      }));
      frames[0].transform = String(keyframes[0].transform);
      frames[steps].transform = String(keyframes[keyframes.length - 1].transform);
      const animation = wrap.animate(frames, { duration, easing, id: 'pswp-radius' });
      setRadius(wrap, to);
      const align = () => {
        if (transition.startTime !== null) animation.startTime = transition.startTime;
      };
      align();
      transition.ready.then(align, () => {});
      transition.finished.then(
        () => animation.cancel(),
        () => {
          animation.cancel();
          syncWrap(wrap);
        }
      );
    };

    document.addEventListener('transitionrun', onTransitionRun);
    lightbox.on('beforeOpen', syncSlides);

    // The closed-state transform is set right before the opening animation starts.
    lightbox.on('openingAnimationStart', syncSlides);
    // Pans, pinches, wheel zoom and the resolution swap after a zoom transition
    // all write the transform through applyCurrentZoomPan, which emits this.
    lightbox.on('zoomPanUpdate', syncSlides);
    lightbox.on('change', syncSlides);

    // PhotoSwipe sizes the placeholder thumbnail as a 250px image scaled up.
    lightbox.on('contentResize', ({ content, width }) => {
      const placeholder = content.placeholder?.element;
      if (placeholder?.tagName === 'IMG') placeholder.style.setProperty('--pswp-ph-scale', String(width / 250 || 1));
    });

    // Parse data from image tags
    lightbox.on('uiRegister', function () {
      lightbox.pswp.ui.registerElement({
        name: 'custom-caption',
        order: 9,
        isButton: false,
        appendTo: 'root',
        html: 'Caption text',
        onInit: (el, pswp) => {
          pswp.on('change', () => {
            const currSlideElement = pswp.currSlide.data.element;
            let captionText = '';
            if (currSlideElement) {
              captionText = currSlideElement.getAttribute('alt') || '';
            }
            el.innerHTML = captionText ? `<div class="pswp-caption-content">${captionText}</div>` : '';
          });
        },
      });
    });

    // Handle opening via validation of data attributes
    lightbox.addFilter('domItemData', (itemData, element) => {
      if (!element) {
        return itemData;
      }

      // Exclude specific images (like logo)
      if (element.classList.contains('pswp-ignore') || element.closest('.content-logo') || element.closest('.logo')) {
        return null;
      }

      // Only include images with proper data attributes or valid src
      const src = element.getAttribute('data-pswp-src') || element.src;

      itemData.src = src;
      itemData.msrc = element.src;

      // SVGs scale without loss but often report a tiny intrinsic size, which made
      // the lightbox open them smaller than the page did. Size them at twice the
      // viewport so they open fitted to the screen and can still zoom in 2x.
      // Camo proxies hex-encode the URL, so ".svg" also shows up as 2e737667.
      if (/\.svg|2e737667/i.test(src)) {
        const rect = element.getBoundingClientRect();
        const ratio = rect.width && rect.height ? rect.width / rect.height : element.naturalWidth / element.naturalHeight || 1;
        const width = Math.round(Math.max(window.innerWidth, window.innerHeight) * 2);
        itemData.w = width;
        itemData.h = Math.round(width / ratio);
        // Transparent SVGs keep the backdrop they had on the page.
        itemData.svgBackground = getComputedStyle(element).backgroundColor;
        return itemData;
      }

      // GIFs keep their original src (rehype leaves them un-rewritten, so the animation is
      // preserved) and fall back to naturalWidth/naturalHeight for lightbox sizing.
      itemData.w = Number(element.getAttribute('data-pswp-width')) || element.naturalWidth || 1000;
      itemData.h = Number(element.getAttribute('data-pswp-height')) || element.naturalHeight || 1000;

      return itemData;
    });

    lightbox.init();
  };

  document.addEventListener('DOMContentLoaded', () => {
    // Open external links in a new tab
    Array.from(document.links).forEach((link) => {
      if (link.hostname !== window.location.hostname) {
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
      }
    });

    // Prevent PhotoSwipe from intercepting clicks on ignored elements
    document.addEventListener(
      'click',
      (e) => {
        if ((e.target as HTMLElement).closest('.pswp-ignore')) {
          e.stopPropagation();
        }
      },
      true
    );

    // Play videos only while in the viewport (autoplay is stripped at build
    // time into data-autoplay so off-screen videos are never fully downloaded)
    const deferredVideos = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');
    if (deferredVideos.length > 0) {
      const videoObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const video = entry.target as HTMLVideoElement;
            if (entry.isIntersecting) {
              video.play().catch(() => {});
            } else if (!video.paused) {
              video.pause();
            }
          });
        },
        { rootMargin: '200px 0px' }
      );
      deferredVideos.forEach((video) => videoObserver.observe(video));
    }

    if (document.querySelector('#write img:not(.pswp-ignore)')) initLightbox();
  });
</script>
