---
// Email signup under each issue. It posts to /api/subscribe, which only mails
// a confirmation link; the address joins the list once that link is
// confirmed. Hidden until the build sets PUBLIC_NEWSLETTER=1, so the form does
// not appear before Resend is configured.
interface Props {
  lang: 'zh' | 'en';
}

const { lang } = Astro.props;
const enabled = import.meta.env.PUBLIC_NEWSLETTER === '1';
const copy =
  lang === 'en'
    ? {
        note: 'Each new issue lands in your inbox.',
        label: 'Email address',
        button: 'Subscribe',
        sent: 'Sent to {email}. {open}.',
        open: 'Check your inbox to confirm',
        invalid: "That email address doesn't look right.",
        failed: "Couldn't send it right now, try again later.",
      }
    : {
        note: '每周新一期发布后发到你的邮箱',
        label: '邮箱地址',
        button: '订阅',
        sent: '邮件已发到 {email}，{open}。',
        open: '去邮箱确认',
        invalid: '邮箱地址的格式不对。',
        failed: '暂时没能发出，过一会儿再试试。',
      };
---

{
  enabled && (
    <form id='newsletter' class='newsletter' hidden data-lang={lang} data-sent={copy.sent} data-open={copy.open} data-invalid={copy.invalid} data-failed={copy.failed}>
      <p class='newsletter-note'>{copy.note}</p>
      <div class='newsletter-row'>
        <input type='email' name='email' required autocomplete='email' maxlength='254' placeholder={copy.label} aria-label={copy.label} />
        <button type='submit'>{copy.button}</button>
      </div>
      <input class='newsletter-trap' type='text' name='website' tabindex='-1' autocomplete='off' aria-hidden='true' />
      <p class='newsletter-status' role='status' aria-live='polite'></p>
    </form>
  )
}

<script>
  // The 邮件订阅 button beside 支持作者 shows the form under the pair. No
  // animation: growing its height reflowed the whole post each frame and
  // stuttered.
  document.querySelectorAll<HTMLButtonElement>('.newsletter-toggle').forEach((toggle) => {
    const form = document.getElementById(toggle.getAttribute('aria-controls') ?? '');
    if (!form) return;
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      form.hidden = !open;
      if (open) form.querySelector<HTMLInputElement>('input[type="email"]')?.focus({ preventScroll: true });
    });
  });

  // Webmail for the common providers, so 去邮箱确认 opens the inbox itself.
  // Company and other domains have no known web address and stay plain text.
  const WEBMAIL: [RegExp, string][] = [
    [/^(gmail|googlemail)\.com$/, 'https://mail.google.com/'],
    [/^(qq|vip\.qq|foxmail)\.com$/, 'https://mail.qq.com/'],
    [/^163\.com$/, 'https://mail.163.com/'],
    [/^126\.com$/, 'https://mail.126.com/'],
    [/^yeah\.net$/, 'https://mail.yeah.net/'],
    [/^vip\.(163|126)\.com$/, 'https://vip.163.com/'],
    [/^188\.com$/, 'https://www.188.com/'],
    [/^(sina\.com|sina\.cn|vip\.sina\.com)$/, 'https://mail.sina.com.cn/'],
    [/^sohu\.com$/, 'https://mail.sohu.com/'],
    [/^aliyun\.com$/, 'https://mail.aliyun.com/'],
    [/^139\.com$/, 'https://mail.10086.cn/'],
    [/^189\.cn$/, 'https://mail.189.cn/'],
    [/^wo\.cn$/, 'https://mail.wo.cn/'],
    [/^tom\.com$/, 'https://mail.tom.com/'],
    [/^263\.net$/, 'https://mail.263.net/'],
    [/^((outlook|hotmail|live)\.[a-z.]+|msn\.com)$/, 'https://outlook.live.com/mail/'],
    [/^(icloud|me|mac)\.com$/, 'https://www.icloud.com/mail'],
    [/^yahoo\.co\.jp$/, 'https://mail.yahoo.co.jp/'],
    [/^(yahoo\.[a-z.]+|ymail\.com|rocketmail\.com)$/, 'https://mail.yahoo.com/'],
    [/^aol\.com$/, 'https://mail.aol.com/'],
    [/^(proton\.me|protonmail\.(com|ch)|pm\.me)$/, 'https://mail.proton.me/'],
    [/^(zoho|zohomail)\.(com|com\.cn)$/, 'https://mail.zoho.com/'],
    [/^(fastmail\.(com|fm))$/, 'https://app.fastmail.com/'],
    [/^hey\.com$/, 'https://app.hey.com/'],
    [/^(tutanota\.(com|de)|tuta\.(io|com))$/, 'https://app.tuta.com/'],
    [/^gmx\.(com|us|co\.uk)$/, 'https://www.gmx.com/'],
    [/^gmx\.(de|net|at|ch)$/, 'https://www.gmx.net/'],
    [/^web\.de$/, 'https://web.de/'],
    [/^(yandex\.[a-z]+|ya\.ru)$/, 'https://mail.yandex.com/'],
    [/^(mail|inbox|list|bk)\.ru$/, 'https://e.mail.ru/'],
    [/^naver\.com$/, 'https://mail.naver.com/'],
    [/^(daum\.net|hanmail\.net)$/, 'https://mail.daum.net/'],
  ];
  const webmailFor = (email: string) => {
    const domain = email.split('@').pop()?.toLowerCase() ?? '';
    return WEBMAIL.find(([pattern]) => pattern.test(domain))?.[1];
  };

  // Writes 邮件已发到 {email}，{open}。 with {open} as a link when the inbox is known.
  const showSent = (status: HTMLElement, template: string, open: string, email: string) => {
    const [before, after = ''] = template.replace('{email}', email).split('{open}');
    const url = webmailFor(email);
    const action = url ? Object.assign(document.createElement('a'), { href: url, target: '_blank', rel: 'noopener', textContent: open }) : document.createTextNode(open);
    status.replaceChildren(before, action, after);
  };

  document.querySelectorAll<HTMLFormElement>('form.newsletter').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.newsletter-status')!;
    const button = form.querySelector<HTMLButtonElement>('button')!;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      button.disabled = true;
      const email = String(data.get('email') ?? '').trim();
      let message = form.dataset.failed;
      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: data.get('email'),
            website: data.get('website'),
            lang: form.dataset.lang,
            topics: ['weekly'],
          }),
        });
        if (response.ok) {
          // Keep the address in the field so a typo stays visible.
          showSent(status, form.dataset.sent ?? '', form.dataset.open ?? '', email);
          button.disabled = false;
          return;
        }
        if (response.status === 400) {
          message = form.dataset.invalid;
        }
      } catch {}
      status.textContent = message ?? '';
      button.disabled = false;
    });
  });
</script>

<style>
  .newsletter {
    width: 100%;
    margin: 20px 0 0;
    padding: 20px;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.03);
  }

  :global([data-theme='dark']) .newsletter {
    background: rgba(255, 255, 255, 0.04);
  }

  .newsletter[hidden] {
    display: none;
  }

  .newsletter-note {
    margin: 0 0 12px;
    font-size: var(--font-size-small);
    color: var(--theme-text);
    opacity: 0.65;
  }

  @media (max-width: 640px) {
    .newsletter-note {
      font-size: 15px;
    }
  }

  .newsletter-row {
    display: flex;
    gap: var(--space-2);
  }

  .newsletter input[type='email'] {
    flex: 1;
    min-width: 0;
    height: 44px;
    padding: 0 var(--space-3);
    border: 1px solid var(--theme-divider);
    border-radius: var(--radius);
    background: var(--theme-bg);
    color: var(--theme-text);
    /* iOS Safari zooms the page into any field under 16px. */
    font-size: 16px;
  }

  .newsletter input[type='email']:focus {
    outline: none;
    border-color: var(--theme-text);
  }

  .newsletter button {
    height: 44px;
    padding: 0 var(--space-4);
    border: 0;
    border-radius: var(--radius);
    background: var(--theme-text);
    color: var(--theme-bg);
    font-size: var(--font-size-small);
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: opacity 0.12s ease-out;
  }

  .newsletter button:hover {
    opacity: 0.8;
  }

  .newsletter button:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .newsletter-trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .newsletter-status:empty {
    display: none;
  }

  .newsletter-status {
    margin: var(--space-2) 0 0;
    font-size: var(--font-size-small);
    color: var(--theme-text);
  }
</style>
