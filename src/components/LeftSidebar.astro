---
const { currentPage } = Astro.props;
import AstroLogo from './Header/AstroLogo.astro';
import { SITE } from '@/config';
import { parseTitle, sortPosts, toNumericUrl } from '@/util';
import { getLangFromUrl, useTranslations, useLocalizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useLocalizedPath(lang);

// Dynamically fetch posts based on language
const posts =
  lang === 'en'
    ? Object.values(import.meta.glob('../pages/en/posts/*.md', { eager: true }))
    : Object.values(import.meta.glob('../pages/posts/*.md', { eager: true }));

const allPosts = sortPosts(posts);

let currentPageMatch = currentPage.slice(1).replace(/\/$/, '');

const sidebarSections = allPosts.reduce((sections, post, index) => {
  const legacySlug = post.frontmatter?.legacySlug;
  const issueTitle = post.frontmatter?.issueTitle;
  const numericUrl = post.frontmatter?.numericUrl ?? toNumericUrl(post.url);
  const route = {
    title: parseTitle(numericUrl, legacySlug, issueTitle, lang),
    link: numericUrl.startsWith('/') ? numericUrl.slice(1) : numericUrl,
  };
  if (index === 0) {
    sections.push({ text: '', children: [] });
  }
  sections[sections.length - 1].children.push(route);
  return sections;
}, []);
---

<nav aria-labelledby='grid-left' class='text-gray-800 dark:text-gray-200'>
  <div class='sidebar-header'>
    <div class='logo flex'>
      <a href={translatePath('/')} class='logo-image' data-astro-prefetch>
        <AstroLogo size={40} />
      </a>
      <a href={translatePath('/')} data-astro-prefetch>
        <h1 class='text-gray-800 dark:text-gray-200'>{t('site.title')}</h1>
      </a>
    </div>
  </div>
  <ul class='nav-groups'>
    {
      sidebarSections.map((section) => (
        <li>
          <div class='nav-group'>
            <ul>
              {section.children.map((child) => (
                <li class='nav-link'>
                  <a
                    data-astro-prefetch
                    href={`/${child.link}`}
                    aria-current={`${decodeURIComponent(currentPageMatch) === child.link ? 'page' : 'false'}`}
                    title={child.title}
                  >
                    {child.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ul>
</nav>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const navGroups = document.querySelector('.nav-groups');

    if (!navGroups) return;

    const restoreScroll = () => {
      const savedScrollPosition = localStorage.getItem('sidebarScrollPosition');
      if (savedScrollPosition !== null) {
        navGroups.scrollTop = parseInt(savedScrollPosition, 10);
      } else {
        const target = document.querySelector('[aria-current="page"]');
        if (target && target.offsetTop > window.innerHeight - 100) {
          navGroups.scrollTop = target.offsetTop - 86;
        }
      }

      navGroups.style.visibility = 'visible';

      localStorage.removeItem('sidebarScrollPosition');
    };

    // A prerendered page runs this before the click that saves the position,
    // so wait until it is actually shown.
    if (document.prerendering) {
      document.addEventListener('prerenderingchange', restoreScroll, { once: true });
    } else {
      restoreScroll();
    }

    navGroups.addEventListener('click', (event) => {
      const link = event.target.closest('a');
      if (link) {
        const scrollPosition = navGroups.scrollTop;
        localStorage.setItem('sidebarScrollPosition', scrollPosition);
      }
    });
  });
</script>

<style>
  nav {
    width: 100%;
    margin-right: 16px;
  }

  .sidebar-header {
    height: var(--theme-navbar-height);
    display: flex;
    align-items: center;
  }
  .nav-groups {
    height: 100%;
    padding: 32px 0;
    overflow-x: visible;
    overflow-y: auto;
    max-height: 100vh;
    visibility: hidden;
  }

  .nav-groups > li + li {
    margin-top: 32px;
  }

  .nav-groups > :first-child {
    padding-top: 0;
  }

  .nav-groups > :last-child {
    padding-bottom: 32px;
    margin-bottom: var(--theme-navbar-height);
  }

  /* The titles sit 6px inside the cup's ink, halfway between flush (read as
     too far left) and the old 11px padding; the cup keeps the header's
     position so it does not move between the feed and an issue. */
  .nav-link a {
    font-size: var(--font-size-base);
    padding: 8px 11px 8px 5px;
    color: inherit;
    text-decoration: none;
    display: block;
    transition: color 200ms ease;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav-link a:hover,
  .nav-link a:focus {
    color: var(--theme-accent);
  }

  .nav-link a[aria-current='page'] {
    color: var(--theme-accent);
    font-weight: 600;
  }

  .logo {
    display: flex;
    font-size: 26px;
    font-weight: bolder;
    flex-shrink: 0;
    font-weight: 600;
    line-height: 1;
    gap: 9px;
    padding: 4px 0;
    margin-top: 0;
  }

  .logo a {
    padding: 8px 4px;
    margin: -8px -4px;
    text-decoration: none;
    font-weight: bold;
    display: block;
  }

  /* Same offset as the header's logo, so going from the home page to an issue
     the cup stays where it was; at 1386px and wider both land on one x. */
  .logo .logo-image {
    margin-top: -14px;
    margin-left: -10px;
  }

  .logo a {
    transition: all 200ms ease;
    color: var(--theme-text);
  }

  .logo a:hover,
  .logo a:focus {
    color: var(--theme-accent);
  }

  /* Title ink at about 0.7 of the cup's, 12px off it; 2px under the cup's
     centre, where the lighter cup body puts its visual weight. */
  .logo h1 {
    font: inherit;
    margin: 0;
    margin-top: -1px;
    margin-left: -2px;
  }

  @media (min-width: 800px) {
    .nav-groups {
      padding: 0;
      margin-top: -8px;
    }
  }
</style>
