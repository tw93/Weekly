---
import { cardImage } from '@/util';

export interface Props {
  allPosts: any[];
}

const { allPosts } = Astro.props;
---

{
  // Preload only the top 3 cards (the LCP candidates); more preloads just
  // compete with the LCP image for early bandwidth, the rest are loading="lazy".
  allPosts.slice(0, 3).map((post) => {
    const image = post.frontmatter.image;
    if (!image) return null;
    const cover = cardImage(image);
    return (
      <link
        rel='preload'
        href={cover.src}
        imagesrcset={cover.srcset}
        imagesizes={cover.sizes}
        as='image'
        fetchpriority='high'
      />
    );
  })
}
