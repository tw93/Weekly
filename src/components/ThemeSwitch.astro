<button id='theme-toggle' class='theme-toggle fixed bottom-6 right-6' aria-label='Toggle theme'>
  <svg class='sun-and-moon' aria-hidden='true' width='24' height='24' viewBox='0 0 24 24'>
    <mask class='moon' id='moon-mask'>
      <rect x='0' y='0' width='100%' height='100%' fill='white'></rect>
      <circle cx='24' cy='10' r='6' fill='black'></circle>
    </mask>
    <circle class='sun' cx='12' cy='12' r='6' fill='currentColor' mask='url(#moon-mask)'></circle>
    <g class='sun-beams' stroke='currentColor'>
      <line x1='12' y1='1' x2='12' y2='3'></line>
      <line x1='12' y1='21' x2='12' y2='23'></line>
      <line x1='4.22' y1='4.22' x2='5.64' y2='5.64'></line>
      <line x1='18.36' y1='18.36' x2='19.78' y2='19.78'></line>
      <line x1='1' y1='12' x2='3' y2='12'></line>
      <line x1='21' y1='12' x2='23' y2='12'></line>
      <line x1='4.22' y1='19.78' x2='5.64' y2='18.36'></line>
      <line x1='18.36' y1='5.64' x2='19.78' y2='4.22'></line>
    </g>
  </svg>
</button>

<style is:global>
  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--theme-text);
    padding: 6px;
    border-radius: var(--radius);
    animation: fadeOut 1s forwards;
    animation-delay: 2s;
    height: 48px;
    width: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .theme-toggle:hover,
  .theme-toggle:active {
    animation: none;
    opacity: 1;
    transition: opacity 1s ease-in-out;
  }

  @keyframes fadeOut {
    0% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  .sun-and-moon > :is(.moon, .sun, .sun-beams, .moon-circle, .moon-crater) {
    transform-origin: center center;
    transition:
      transform 0.5s ease,
      opacity 0.5s ease;
  }

  .sun-and-moon > :is(.moon, .sun) {
    fill: currentColor;
  }

  .theme-toggle:is(:hover, :focus-visible) {
    color: var(--theme-accent);
  }

  .sun-and-moon > .sun-beams {
    stroke: currentColor;
    stroke-width: 2px;
  }

  .moon-circle {
    transition: transform 0.5s ease;
  }

  [data-theme='dark'] .sun-and-moon > .sun {
    transform: scale(1.75);
  }

  [data-theme='dark'] .sun-and-moon > .sun-beams {
    opacity: 0;
  }

  [data-theme='dark'] .sun-and-moon > .moon > circle {
    transform: translateX(-7px);
    transition: transform 0.5s ease;
  }

  [data-theme='dark'] .moon-circle {
    transform: translateX(-12px) scale(0.92);
  }

  [data-theme='dark'] .moon-crater {
    transform: translateX(-7px);
  }

  [data-theme='light'] .moon-circle,
  [data-theme='light'] .moon-crater {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .sun-and-moon > :is(.moon, .sun, .sun-beams, .moon-circle, .moon-crater) {
      transition: none;
    }
  }
</style>

<script is:inline>
  const GISCUS_ORIGIN = 'https://giscus.app';
  const giscusThemeUrl = (theme) => `${window.location.origin}/styles/giscus-${theme}.css`;

  // Giscus drops messages sent before its app has mounted, so theme changes
  // wait for its first message (it always reports its height on load).
  let giscusReady = false;
  let pendingGiscusTheme = null;

  const postGiscusTheme = (url) => {
    const iframe = document.querySelector('iframe.giscus-frame');
    iframe?.contentWindow?.postMessage({ giscus: { setConfig: { theme: url } } }, GISCUS_ORIGIN);
  };

  window.addEventListener('message', (event) => {
    if (event.origin !== GISCUS_ORIGIN || !event.data?.giscus || giscusReady) return;
    giscusReady = true;
    const iframe = document.querySelector('iframe.giscus-frame');
    const bornTheme = iframe && new URL(iframe.src).searchParams.get('theme');
    if (pendingGiscusTheme && pendingGiscusTheme !== bornTheme) postGiscusTheme(pendingGiscusTheme);
    pendingGiscusTheme = null;
  });

  const changeGiscusTheme = (url) => {
    // Not executed yet: client.js reads data-theme when it runs.
    document.getElementById('giscus-script')?.setAttribute('data-theme', url);
    if (giscusReady) {
      postGiscusTheme(url);
    } else {
      pendingGiscusTheme = url;
    }
  };

  window.addEventListener('DOMContentLoaded', () => {
    const themeToggle = document.getElementById('theme-toggle');
    const prefersDarkScheme = window.matchMedia('(prefers-color-scheme: dark)');
    const root = document.documentElement;
    const setTheme = (theme) => {
      root.classList.toggle('dark', theme === 'dark');
      root.dataset.theme = theme;
      changeGiscusTheme(giscusThemeUrl(theme));
      try {
        localStorage.setItem('theme', theme);
      } catch {}
    };

    const toggleTheme = () => {
      setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
    };

    themeToggle.addEventListener('click', toggleTheme);
    // HeadCommon re-reads the theme when a prerendered page is shown; the
    // comment iframe was created during prerender and may need to follow.
    document.addEventListener('prerenderingchange', () => changeGiscusTheme(giscusThemeUrl(root.dataset.theme)), {
      once: true,
    });
    prefersDarkScheme.addEventListener('change', (e) => setTheme(e.matches ? 'dark' : 'light'));
  });
</script>
