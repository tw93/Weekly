---
import '@pagefind/default-ui/css/ui.css';
import SearchIcon from './SearchIcon.astro';
---

<site-search id='search' class='ms-auto relative md:inline-block hidden site-search'>
  <button
    data-open-modal
    disabled
    class='flex items-center justify-center rounded-full gap-1 search-icon !bg-gray-100 dark:!bg-gray-800 !text-gray-600 dark:!text-gray-400 hover:!text-gray-900 dark:hover:!text-gray-200'
    title='输入/进行搜索'
    aria-label='Search'
  >
    <SearchIcon />
  </button>
  <dialog
    aria-label='search'
    class='h-full max-h-full w-full max-w-full shadow backdrop:backdrop-blur sm:mx-auto sm:mb-auto sm:mt-16 sm:h-max sm:max-h-[calc(100%-8rem)] sm:min-h-[15rem] sm:w-5/6 sm:max-w-[48rem] sm:rounded-md opacity-0 text-left'
  >
    <div class='dialog-frame flex flex-col gap-4 p-6 pt-12 sm:pt-6'>
      <button data-close-modal class='ms-auto cursor-pointer rounded-full px-4 py-2 close-icon'>X</button>
      {
        import.meta.env.DEV ? (
          <div class='mx-auto text-center'>
            <p>
              Search is only available in production builds. <br />
              Try building and previewing the site to test it out locally.
            </p>
          </div>
        ) : (
          <div class='search-container w-full'>
            <div id='pagefind__search' />
          </div>
        )
      }
    </div>
  </dialog>
</site-search>

<script>
  // PagefindUI is ~94KB, so it loads when the reader shows intent to search
  // (hovering or focusing the button, or opening the dialog), not on every page.
  let pagefindLoading: Promise<void> | null = null;
  const loadPagefind = () => {
    if (import.meta.env.DEV) return Promise.resolve();
    return (pagefindLoading ??= import('@pagefind/default-ui').then(({ PagefindUI }) => {
      new PagefindUI({
        element: '#pagefind__search',
        baseUrl: import.meta.env.BASE_URL,
        bundlePath: import.meta.env.BASE_URL.replace(/\/$/, '') + '/pagefind/',
        showImages: false,
        translations: {
          placeholder: '搜索潮流内容',
          zero_results: '没有找到 [SEARCH_TERM]',
          many_results: '[COUNT] 条搜索命中 [SEARCH_TERM]',
          clear_search: '清除',
          load_more: '加载更多结果',
        },
      });
    }));
  };

  class SiteSearch extends HTMLElement {
    constructor() {
      super();
      const openBtn = this.querySelector('button[data-open-modal]') as HTMLButtonElement;
      const closeBtn = this.querySelector('button[data-close-modal]') as HTMLButtonElement;
      const dialog = this.querySelector('dialog');
      const dialogFrame = this.querySelector('.dialog-frame');

      if (openBtn && closeBtn && dialog && dialogFrame) {
        const onWindowClick = (event) => {
          if (document.body.contains(event.target) && !dialogFrame.contains(event.target)) closeModal();
        };

        const openModal = (event) => {
          dialog.showModal();

          // The dialog starts at opacity-0; keep the end state once the animation ends.
          dialog.style.opacity = '1';
          dialog.animate(
            {
              clipPath: ['polygon(0 0, 100% 0, 100% -200%, -200% -200%)', 'polygon(0 0, 100% 0, 100% 100%, 0% 100%)'],
              opacity: [0, 1],
            },
            { duration: 200 }
          );
          document.body.classList.add('overflow-hidden');
          this.querySelector('input')?.focus();
          // On first open the search input is created once PagefindUI loads.
          loadPagefind().then(() => dialog.open && this.querySelector('input')?.focus());
          event?.stopPropagation();
          window.addEventListener('click', onWindowClick);
        };

        const closeModal = () => {
          dialog.close();
          document.body.classList.remove('overflow-hidden');
          window.removeEventListener('click', onWindowClick);
        };

        openBtn.addEventListener('click', openModal);
        openBtn.disabled = false;
        closeBtn.addEventListener('click', closeModal);
        document.addEventListener('astro:after-swap', closeModal);

        window.addEventListener('keydown', (e) => {
          if (e.key === '/' && !dialog.open) {
            openModal(e);
            e.preventDefault();
          }
        });

        const searchElement = this.querySelector('#pagefind__search');
        const interactiveSelector = 'a, button, input, textarea, select, label';

        const findResultLink = (target: Element) => {
          const nestedResult = target.closest('.pagefind-ui__result-nested');
          if (nestedResult) {
            return nestedResult.querySelector('.pagefind-ui__result-title .pagefind-ui__result-link');
          }
          const result = target.closest('.pagefind-ui__result');
          return result?.querySelector('.pagefind-ui__result-title .pagefind-ui__result-link');
        };

        const navigateFromResult = (event: MouseEvent) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          if (target.closest(interactiveSelector)) return;

          const resultLink = findResultLink(target);
          if (!(resultLink instanceof HTMLAnchorElement)) return;

          const selectedText = window.getSelection()?.toString().trim();
          if (selectedText) return;

          event.preventDefault();
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.button === 1) {
            window.open(resultLink.href, '_blank', 'noopener,noreferrer');
            return;
          }

          window.location.assign(resultLink.href);
        };

        searchElement?.addEventListener('click', (event) => {
          if (!(event instanceof MouseEvent) || event.button !== 0) return;
          navigateFromResult(event);
        });

        searchElement?.addEventListener('auxclick', (event) => {
          if (!(event instanceof MouseEvent) || event.button !== 1) return;
          navigateFromResult(event);
        });

        for (const event of ['pointerenter', 'focus', 'touchstart']) {
          openBtn.addEventListener(event, () => loadPagefind(), { once: true, passive: true });
        }
      }
    }
  }

  customElements.define('site-search', SiteSearch);
</script>

<style is:global>
  body {
    --pagefind-ui-primary: #a67c52;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-font:
      'TsangerJinKai02', 'STKaiti', 'KaiTi', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif,
      'Apple Color Emoji', 'Segoe UI Emoji';
  }

  .site-search {
    font-size: var(--font-size-base);
  }

  .pagefind-ui__search-input {
    font-size: var(--font-size-small);
  }

  .site-search .pagefind-ui__search-input:focus,
  .site-search .pagefind-ui__search-input:focus-visible {
    outline: none;
    box-shadow: none;
  }

  .search-icon {
    outline: none;
    height: 36px;
    min-height: 36px;
    width: 36px;
    min-width: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
  }

  .site-search .pagefind-ui__message {
    margin-block-start: 0;
    margin-block-end: 0;
    padding: 8px 0 16px;
  }

  .content-title .site-search .pagefind-ui__message {
    padding: 8px 0;
  }

  .content-title .site-search {
    margin-left: 8px;
  }

  .site-search .pagefind-ui__result {
    padding: 20px 0 !important;
    cursor: pointer;
  }

  .site-search .close-icon {
    font-size: var(--font-size-small);
  }

  .site-search .pagefind-ui__button {
    margin-top: 0;
  }

  .site-search .pagefind-ui__result-title .pagefind-ui__result-link:hover {
    text-decoration: none !important;
    color: #a67c52;
    border-block-end: none;
  }

  .site-search .pagefind-ui__search-clear {
    font-size: 12px;
  }
</style>
