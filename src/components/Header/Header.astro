---
import { SITE } from '@/config';
import AstroLogo from './AstroLogo.astro';
import HeaderRight from './HeaderRight.astro';
import { getLangFromUrl, useTranslations, useLocalizedPath } from '../../i18n/utils';

export interface Props {
  /** `feed` matches the homepage card grid width; `page` keeps the article/about width. */
  layout?: 'feed' | 'page';
}

const { layout = 'page' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useLocalizedPath(lang);

const navClass = `nav-wrapper mx-auto ${layout === 'feed' ? 'feed-container' : 'page-container'}`;
---

<header>
  <nav class={navClass} title={t('site.title')}>
    <div class='logo flex content-logo'>
      <a href={translatePath('/')} class='logo-image' aria-label={t('site.title')}>
        <AstroLogo size={40} class='pswp-ignore' />
      </a>
      <a href={translatePath('/')}>
        <h1 class='text-gray-800 dark:text-gray-200'>{t('site.title')}</h1>
      </a>
    </div>
    <HeaderRight />
  </nav>
</header>

<style>
  header {
    height: var(--theme-navbar-height);
    width: 100%;
    background-color: var(--theme-navbar-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    top: 0;
  }

  .logo {
    display: flex;
    font-size: 26px;
    flex-shrink: 0;
    font-weight: 600;
    line-height: 1;
    gap: 9px;
  }

  .logo a {
    padding: 8px 4px;
    margin: -8px -4px;
    text-decoration: none;
    font-weight: bolder;
    display: block;
    transition: all 200ms ease;
    color: var(--theme-text);
  }

  .logo a:hover,
  .logo a:focus {
    color: var(--theme-accent);
  }

  /* The cup sits 21px inside its 144px canvas, 6px at 40px; pull it out so its
     ink, not the transparent margin, lines up with the content edge. */
  .logo .logo-image {
    margin-top: -14px;
    margin-left: -10px;
  }

  /* Title ink at about 0.7 of the cup's, 12px off it and centred on it. */
  .logo h1 {
    font: inherit;
    margin: 0;
    margin-top: -5px;
    margin-left: -2px;
  }

  .nav-wrapper {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 36px;
  }

  @media (max-width: 800px) {
    .nav-wrapper {
      margin-top: 5px;
      margin-bottom: 5px;
    }
  }
</style>
