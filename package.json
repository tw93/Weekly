{
  "name": "weekly",
  "description": "潮流周刊，记录工程师 Tw93 的不枯燥生活，每周一发布，希望你喜欢",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/tw93/weekly.git"
  },
  "author": {
    "name": "Tw93",
    "email": "tw93@qq.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/probe-images.js",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "postbuild": "pagefind --site dist --silent",
    "image:probe": "node scripts/probe-images.js",
    "brand:generate": "node scripts/generate-brand-assets.js",
    "sync:content": "node build.js && astro build && node scripts/generate-weekly-skill.js --write-from-api dist/api/posts.json",
    "check:content": "node scripts/check-content-parity.js --dist-api dist/api/posts.json",
    "test:unit": "node --test tests/*.test.js",
    "test": "pnpm test:unit && astro build && pnpm check:content"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@pagefind/default-ui": "^1.3.0",
    "astro": "^5.15.8",
    "axios": "^1.11.0",
    "dayjs": "^1.11.13",
    "motion": "^10.18.0",
    "pagefind": "^1.3.0",
    "photoswipe": "^5.4.4",
    "remark-breaks": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/rss": "^4.0.13",
    "@astrojs/tailwind": "^6.0.2",
    "@tailwindcss/typography": "^0.5.16",
    "@types/lozad": "^1.16.4",
    "node-html-parser": "^6.1.13",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.13.0",
    "probe-image-size": "^7.2.3",
    "rehype": "^13.0.2",
    "rehype-parse": "^9.0.1",
    "sharp": "0.34.5",
    "tailwindcss": "^3.4.17",
    "throat": "^6.0.2",
    "unist-util-visit": "^5.0.0"
  }
}
